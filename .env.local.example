# Firebase Realtime Database — skopiuj do .env.local i uzupełnij z Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcjonalny TURN (gdy STUN nie wystarcza, np. LTE / restrykcyjne Wi‑Fi)
# NEXT_PUBLIC_TURN_URL=turn:global.turn.twilio.com:3478?transport=udp
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
